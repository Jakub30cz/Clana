{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clauna",
  "version": "0.1.0",
  "identifier": "cz.orgrez.clauna",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Clauna",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Minimalist vibe-coding IDE",
    "longDescription": "Clauna is a minimalist coding IDE focused on flow: file tree, splits, integrated terminal, and Claude Code at a keystroke."
  }
}
